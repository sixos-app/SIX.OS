{
  "name": "six-os",
  "private": true,
  "version": "0.48.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:ui": "vite",
    "dev": "pnpm build && pnpm wrangler pages dev dist --compatibility-date=2026-08-04 --local",
    "build": "tsc -b && vite build",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "security:rotate-password": "tsx scripts/rotate-user-password.ts",
    "test:rbac": "tsx scripts/test_rbac_v2.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:workflow": "tsx scripts/test_workflow_lifecycle.ts",
    "test:agenda": "tsx scripts/test_agenda_expansion.ts",
    "test": "tsx scripts/certify-beta.ts",
    "certify:beta": "tsx scripts/certify-beta.ts",
    "preview": "vite preview",
    "db:migrate": "pnpm wrangler d1 migrations apply six-os --local",
    "db:seed-demo": "pnpm wrangler d1 execute six-os --local --file=./scripts/seed_dev.sql",
    "db:bootstrap": "tsx scripts/bootstrap_clean_tenant.ts",
    "db:reset": "ALLOW_DESTRUCTIVE_TENANT_RESET=YES TARGET_ORGANIZATION_ID=org-six tsx scripts/reset-agency-baseline.ts",
    "db:reset-demo": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate && pnpm db:seed-demo",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "jose": "^6.2.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "^4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wrangler": "4.120.0"
  }
}
